	# Default: 0.02
	# Range: 0.0 ~ 1.0
	deathLossFraction = 0.02
	# Default: 1
	# Range: 0 ~ 9223372036854775807
	minimumDeathLossTrace = 1
	# Default: 500000
	# Range: 1 ~ 9223372036854775807
	earlyWealthReviewTrace = 500000
	#Maximum legacy accounts observed and maximum developer messages sent per review interval (separate global budgets).
	# Default: 8
